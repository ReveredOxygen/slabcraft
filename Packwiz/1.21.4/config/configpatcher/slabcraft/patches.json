{
    "2.0.0": [
        {
            "target": "config/xaerominimap.txt",
            "description": "Disable entity radar in xaeros",
            "replaceString": {
                "original": "entityRadar:true",
                "replacement": "entityRadar:false"
            }
        },
        {
            "target": "config/xaerominimap.txt",
            "description": "Disable cave maps in xaeros minimap",
            "regex": {
                "regex": "caveMaps:\\d+",
                "replacement": "caveMaps:0"
            }
        },
        {
            "target": "config/xaerominimap.txt",
            "description": "Disable auto update in xaeros minimap",
            "replaceString": {
                "original": "ignoreUpdate:0",
                "replacement": "ignoreUpdate:1"
            }
        },
        {
            "target": "config/xaeroworldmap.txt",
            "description": "Disable auto update in xaeros world map",
            "replaceString": {
                "original": "ignoreUpdate:0",
                "replacement": "ignoreUpdate:1"
            }
        },
        {
            "target": "options.txt",
            "description": "Reconfigure enabled resource packs",
            "regex": {
                "regex": "(?m)^resourcePacks:.*$",
                "replacement": "resourcePacks:[\"vanilla\",\"fabric\",\"file/SodiumTranslations.zip\",\"file/Mod Menu Helper.zip\",\"file/Chat Reporting Helper.zip\",\"file/Fast Better Grass.zip\",\"file/LGBeeT_1.20.3-1.20.4.zip\",\"file/Slabcraft.zip\"]"
            }
        },
        {
            "target": "options.txt",
            "description": "Reconfigure incompatible but enabled resource packs",
            "regex": {
                "regex": "(?m)^incompatibleResourcePacks:.*$",
                "replacement": "incompatibleResourcePacks:[\"appleskin\",\"controlling\",\"searchables\",\"xaerominimap\",\"xaeroworldmap\",\"yet_another_config_lib_v3\",\"file/LGBeeT_1.20.3-1.20.4.zip\",\"file/Slabcraft.zip\"]"
            }
        },
        {
            "target": "config/inventoryprofilesnext/inventoryprofiles.json",
            "description": "Disable armor refill",
            "regex": {
                "regex": "AutoRefillSettings\": \\{",
                "replacement": "AutoRefillSettings\": { \"refill_armor\": {\"value\": false}, \"auto_refill_enable_indicator_icons\": {\"value\": false},"
            }
        },
        {
            "target": "config/inventoryprofilesnext/inventoryprofiles.json",
            "description": "Disable r+y spamming chat",
            "regex": {
                "regex": "Hotkeys\": \\{",
                "replacement": "Hotkeys\": { \"reload_custom_configs\": { \"main\": { \"keys\": \"\" } },"
            }
        },
        {
            "target": "config/inventoryprofilesnext/inventoryprofiles.json",
            "description": "Disable r+y spamming chat",
            "regex": {
                "regex": "Hotkeys\": \\{",
                "replacement": "Hotkeys\": { \"reload_custom_configs\": { \"main\": { \"keys\": \"\" } },"
            }
        },
        {
            "target": "config/inventoryprofilesnext/inventoryprofiles.json",
            "description": "Disable continuous crafting by default",
            "regex": {
                "regex": "\\},\\s*\"AutoRefillSettings",
                "replacement": ", \"continuous_crafting_saved_value\": false }, \"AutoRefillSettings"
            }
        },
        {
            "target": "config/capes.json5",
